# URI Runtime base image: validates contracts and runs plan/matrix tests.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app \
    URIVISION_BACKEND_PROFILE=mock-local

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY examples ./examples
COPY tools ./tools
COPY docs ./docs
RUN pip install --no-cache-dir -e .

CMD ["python", "tools/run_backend_matrix.py", "--out", "artifacts/backend-matrix.json", "--markdown", "artifacts/backend-matrix.md"]
