# Linux X11/noVNC harness. This prepares the OS packages; URI handlers remain
# contract adapters until a real VNC/X11 connector is mounted into /app/adapters.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src:/app \
    URIVISION_BACKEND_PROFILE=linux-x11-novnc \
    DISPLAY=:99

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc fluxbox xterm xdotool dbus-x11 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY examples ./examples
COPY tools ./tools
COPY docker/entrypoint-x11-novnc.sh ./docker/entrypoint-x11-novnc.sh
RUN pip install --no-cache-dir -e . && chmod +x ./docker/entrypoint-x11-novnc.sh

CMD ["./docker/entrypoint-x11-novnc.sh"]
